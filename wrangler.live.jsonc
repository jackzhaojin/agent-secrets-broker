// Agent Secrets Broker, LIVE deployment: real accounts. Separate from the sandbox (wrangler.jsonc)
// so real secrets never share a Worker, KV namespace or state with test fixtures.
// Secrets are Cloudflare Worker secrets for now (src/live.ts); deploy with `npm run deploy:live`.
// The 1Password variant (src/live-1password.ts) deploys with `npm run deploy:live:1password`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-secrets-broker-live",
  "main": "src/live.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: CIMD fetches (SSRF protection). nodejs_compat: the 1Password SDK variant.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_BASE_URL": "https://agent-secrets-broker-live.jackzhaojin.workers.dev",
    "ENVIRONMENT": "live",
    "SECRET_CACHE_TTL_SECONDS": "300",
    // The only da.live folder the DA tools may touch ("org/site/folder"). Jack named it on
    // 2026-11-12 (https://main--www-eds--jackzhaojin.aem.page/drafts/sites-ai-webinar/). It holds
    // his real "Sites and AI" webinar page, so da_put_draft can replace that page: every call
    // needs his approval, and the approval page shows the path.
    "DA_SCRATCH": "jackzhaojin/www-eds/drafts/sites-ai-webinar"
  },
  // Worker secrets, never committed:
  //   OWNER_PASSWORD                                        Jack, `wrangler secret put`
  //   ADOBE_OAUTH_CLIENT_ID, ADOBE_OAUTH_CLIENT_SECRET      Jack, `wrangler secret put` (Adobe OAuth Web App credential)
  //   OP_SERVICE_ACCOUNT_TOKEN  only for the 1Password variant (read-only service account, vault Broker)
  //   ADMIN_TOKEN, COOKIE_SECRET, TOKEN_ENC_KEY  random, `npm run live -- init-keys` (never printed)
  "kv_namespaces": [
    // OAuth clients, grants and tokens (hashed), owned by @cloudflare/workers-oauth-provider
    { "binding": "OAUTH_KV", "id": "8f8d8303c8594c0fbedc5c8ecd794dae" },
    // Broker state: policy override, audit log, login rate limits, Adobe tokens (AES-GCM sealed)
    { "binding": "BROKER_KV", "id": "1dc351047ffb4a0b849fd1d9741742cf" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "APPROVALS", "class_name": "ApprovalStore" },
      { "name": "REVOCATIONS", "class_name": "RevocationList" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApprovalStore", "RevocationList"] }],
  // Daily: keep Jack's Adobe refresh token alive (Adobe expires it after 14 days without use).
  "triggers": { "crons": ["17 9 * * *"] },
  "version_metadata": { "binding": "CF_VERSION" }
}
